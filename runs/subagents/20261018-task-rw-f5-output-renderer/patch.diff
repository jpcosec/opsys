+                    "pane_count": 1,
+                    "focused": True,
+                }
+            ]
+        }
+    }
+elif sys.argv[1:3] == ["agent", "list"]:
+    payload = {
+        "result": {
+            "agents": [
+                {
+                    "pane_id": "w-1:p-1",
+                    "agent": "pi",
+                    "name": "executor",
+                    "agent_status": "idle",
+                    "cwd": "/tmp/golden-work",
+                    "workspace_id": "w-1",
+                    "tab_id": "t-1",
+                    "terminal_title_stripped": "deskops executor",
+                    "state_change_seq": 7,
