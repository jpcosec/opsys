+def _store_snapshot(repo: Path) -> dict[str, bytes]:
+    store = repo / ".sldb"
+    return {
+        path.relative_to(store).as_posix(): path.read_bytes()
+        for path in sorted(store.rglob("*"))
+        if path.is_file()
+    }
+
